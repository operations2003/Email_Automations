# ==============================================================================
# AutoReach AI - Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: NEVER commit your actual .env or .env.local file with real secrets!
# ==============================================================================

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/tasknera?retryWrites=true&w=majority"

# Company Email & SMTP Delivery Configuration
# For Google Workspace / Gmail, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_PROVIDER="smtp"
EMAIL_USER="your_company_email@example.com"
EMAIL_PASSWORD="your_new_app_password"
EMAIL_SENDER_NAME="TaskNera Operations"
DEFAULT_CC="operations@example.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false

# Alternative Email Provider (Resend)
RESEND_API_KEY=""

# AI Engine Configuration (OpenAI)
# Optional: built-in intelligent semantic engine operates automatically when empty
OPENAI_API_KEY=""

# System Role Authentication Credentials (Optional overrides)
ADMIN_EMAIL="sheetalbedi@example.com"
ADMIN_PASSWORD="your_secure_admin_password"
EMPLOYEE_EMAIL="employee@example.com"
EMPLOYEE_PASSWORD="your_secure_employee_password"
